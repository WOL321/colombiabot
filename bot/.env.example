# 🇨🇴 Colombia Pride Bot - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit your actual .env file to git!

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# The channel ID where the bot will send pride messages
# Right-click on a channel in Discord → Copy ID
DISCORD_CHANNEL_ID=your_channel_id_here

# The channel ID where the bot will send polls (optional)
# Leave empty or remove this line to disable polls
# Right-click on a channel in Discord → Copy ID
DISCORD_POLL_CHANNEL_ID=your_poll_channel_id_here
